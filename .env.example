# ---------------------------------------------------------------------------
# Ember & Oven — environment template.
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Never commit secrets: `.env` must stay out of version control.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Where the browser app runs in development (used for logging + CORS-free proxy hints)
APP_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# SQLite file path, relative to the repository root (or absolute).
DB_FILE=server/data/ember-oven.sqlite

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=eo_session
SESSION_TTL_HOURS=168
# Set to true only when the API is served over HTTPS.
COOKIE_SECURE=false

# --- Staff account (kitchen dashboard) -------------------------------------
# The seed script creates/refreshes this account. Leave the password empty to have
# a random one-time password generated and printed by `npm run db:seed`.
STAFF_EMAIL=staff@ember-oven.local
STAFF_PASSWORD=

# --- Payment provider ------------------------------------------------------
# `mock` = local test payment flow (no money moves, nothing is charged).
# `razorpay` / `stripe` are wired but require real keys, which must come from the
# environment of the deployment — never from this file in version control.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# --- Kitchen promise + cancellation window ---------------------------------
ETA_MIN_MINUTES=10
ETA_MAX_MINUTES=15
CANCEL_WINDOW_MINUTES=5
